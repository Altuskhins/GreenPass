        "kind": "tuic",
        "name": str(r.get("name", "TUIC узел") or "TUIC узел"),
        "uuid": uuid,
        "password": password,
        "server": str(r.get("host", "") or ""),
        "port": int(r.get("port", 0) or 0),
        "network": "udp",
        "security": "tls",
        "params": params,
    }


